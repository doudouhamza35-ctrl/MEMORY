# Copy to .env or set these in your host's dashboard
PORT=3000
# Persistent folder (database + uploads). MUST be on a persistent disk/volume.
DATA_DIR=./data
# First-run admin code only (hashed on first start, then ignored). Change it from the dashboard.
ADMIN_INITIAL_CODE=1111
SITE_URL=https://your-domain.com
# Comma-separated exact origins allowed to call the public API from a static site
ALLOWED_ORIGINS=https://memory-artdz.netlify.app
# Set to 1 when running behind a proxy/HTTPS host (Render, Railway, Nginx...)
TRUST_PROXY=1
MAX_UPLOAD_MB=60
# Optional: agency website; makes "DOUMIN ART PRODUCTION" in the footer a link
AGENCY_URL=
